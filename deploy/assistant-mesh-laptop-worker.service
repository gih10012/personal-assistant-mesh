[Unit]
Description=Personal assistant laptop Codex worker
After=assistant-mesh-tunnel.service
Wants=assistant-mesh-tunnel.service

[Service]
Type=simple
WorkingDirectory=%h/Github/personal-assistant-mesh
ExecStart=/usr/bin/python3 -m assistant_mesh --config %h/.local/state/personal-assistant-mesh/laptop-worker.json worker
Restart=on-failure
RestartSec=5
UMask=0077
# Native runtime keeps the owner's normal OS permissions. Mesh API policies
# must not become a process-wide restriction on its original tools.

[Install]
WantedBy=default.target
