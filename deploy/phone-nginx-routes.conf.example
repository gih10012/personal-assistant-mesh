# Root replaces PHONE_LOOPBACK_PORT with its reserved port, preserving all
# existing locations, media handling, TLS and OAuth routes. No /v1/ wildcard.
location = /enrollment/node {
    proxy_pass http://127.0.0.1:PHONE_LOOPBACK_PORT;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 1m;
}
location = /phone/node {
    proxy_pass http://127.0.0.1:PHONE_LOOPBACK_PORT;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 128k;
}
location = /v1/harmony/updates/manifest {
    proxy_pass http://127.0.0.1:PHONE_LOOPBACK_PORT;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}
location ~ ^/v1/harmony/updates/artifacts/[0-9a-f]{64}$ {
    proxy_pass http://127.0.0.1:PHONE_LOOPBACK_PORT;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}
