{
  "format": "mesh-enrollment/1",
  "mesh_id": "replace-with-existing-mesh-identity",
  "node_id": "replace-with-stable-owned-node-identity",
  "owner_binding": "replace-with-existing-owner-binding",
  "repo_pin": {
    "repository": "https://github.com/gih10012/personal-assistant-mesh",
    "commit": "0000000000000000000000000000000000000000"
  },
  "runtime": {
    "kind": "interactive",
    "expires_at": null,
    "state_ref": "private:existing-persistent-mesh-state"
  },
  "join": {
    "peer_id": "replace-with-known-peer",
    "authority_id": "replace-with-known-authority",
    "route_ref": "private:authorized-existing-route",
    "credential_ref": "private:scoped-credential-handle-not-secret-value",
