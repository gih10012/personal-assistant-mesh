[Unit]
Description=Autonomous laptop agent node and authenticated A2A reconnect supervisor
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Github/personal-assistant-mesh
ExecStart=/usr/bin/python3 -m assistant_mesh --config %h/.local/state/personal-assistant-node/node.json node
Restart=on-failure
RestartSec=5
UMask=0077
# This node owns a native worker; Mesh policies do not sandbox native tools.

[Install]
WantedBy=default.target
