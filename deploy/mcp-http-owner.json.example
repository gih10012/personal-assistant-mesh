{
  "format": "mesh-mcp-http-owner/1",
  "policy": {
    "format": "mesh-mcp-http/1",
    "resource_url": "https://mesh.example.invalid/mcp",
    "issuer_url": "https://existing-idp.example.invalid",
    "issuer_metadata": {
      "issuer": "https://existing-idp.example.invalid",
      "authorization_endpoint": "https://existing-idp.example.invalid/authorize",
      "token_endpoint": "https://existing-idp.example.invalid/token",
      "code_challenge_methods_supported": ["S256"],
      "token_endpoint_auth_methods_supported": ["none"]
    },
    "owner_binding": "REPLACE_EXISTING_VERIFIED_OWNER_BINDING",
    "subjects": [
      {
        "issuer_subject": "REPLACE_EXISTING_IDP_OWNER_SUBJECT",
        "mesh_subject": "REPLACE_FIXED_MAIN_CHAT_INGRESS_SUBJECT",
        "client_ids": ["REPLACE_ACTUAL_APPROVED_OAUTH_CLIENT_ID"],
        "scopes": ["tasks:read", "tasks:submit"]
      }
    ],
    "allowed_origins": [],
    "max_request_bytes": 65536
  },
  "existing_idp_jwt": {
    "jwks_url": "https://existing-idp.example.invalid/.well-known/jwks.json",
    "algorithms": ["RS256"],
    "client_id_claim": "client_id"
  },
  "ingress_clients": {
    "REPLACE_FIXED_MAIN_CHAT_INGRESS_SUBJECT": "/PRIVATE/REPLACE_EXISTING_DEDICATED_INGRESS_CLIENT.json"
  }
}
