[Unit]
Description=Bounded native WeChat refresh bridge for cloud ClawBot
After=assistant-mesh-tunnel.service
Wants=assistant-mesh-tunnel.service

[Service]
Type=simple
WorkingDirectory=%h/Github/personal-assistant-mesh
ExecStart=/usr/bin/python3 -m assistant_mesh --config %h/.local/state/personal-assistant-mesh/native-recovery.json recovery
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
