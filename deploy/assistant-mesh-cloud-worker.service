[Unit]
Description=Personal assistant cloud Codex worker
After=assistant-mesh.service network-online.target
Wants=assistant-mesh.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/personal-assistant-mesh
ExecStart=/usr/bin/python3 -m assistant_mesh --config %h/.local/state/personal-assistant-mesh/cloud-worker.json worker
Restart=on-failure
RestartSec=10
UMask=0077
# Do not add a native-tool privilege or temporary-files namespace restriction.
# The owner's existing OS permissions still apply; no new privileges are granted.
# Native runtime measured above 350 MiB. The cloud has existing services;
# pressure can use its configured swap, without unbounded memory growth.
MemoryHigh=500M
MemoryMax=650M
MemoryLimit=650M

[Install]
WantedBy=default.target
